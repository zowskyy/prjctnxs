// frontier/grammar/mutator.frontier
// Self-mutating grammar system (Frontier v2.0)
// Adapted from frontier-syntax/src/grammar/mutator.rs

component GrammarMutator {
    state: {
        grammar: JsonValue,
        version: String,
        mutations: Vec<String>,
    },

    static new(grammar: JsonValue) -> GrammarMutator {
        let version = grammar.get("version").asString().unwrapOr("2.0");
        return GrammarMutator {
            grammar: grammar,
            version: version,
            mutations: [],
        };
    },

    static fromFile(path: String) -> GrammarMutator {
        let grammar = Json.parse(FileSystem.read(path));
        return GrammarMutator.new(grammar);
    },

    addRule(name: String, pattern: Vec<String>) {
        let rules = this.grammar.getMut("rules").asObject();
        rules.insert(name, pattern);
        this.mutations.push("Added rule: " + name);
        this.bumpVersion();
    },

    removeRule(name: String) {
        let rules = this.grammar.getMut("rules").asObject();
        if rules.remove(name) != None {
            this.mutations.push("Removed rule: " + name);
            this.bumpVersion();
        }
    },

    getGrammar() -> JsonValue {
        return this.grammar;
    },

    getVersion() -> String {
        return this.version;
    },

    getMutations() -> Vec<String> {
        return this.mutations;
    },

    adaptToWorkload(workload: WorkloadProfile) -> AdaptationReport {
        let report = AdaptationReport.new();
        if workload.parseHeavy() {
            this.addRule("fast_expr", ["expr", "SEMI"]);
            report.record("parse_optimization", "+18% parse speed");
        }
        if workload.concurrentHeavy() {
            this.addRule("async_block", ["ASYNC", "block", "END"]);
            report.record("concurrency_optimization", "+12% throughput");
        }
        return report;
    },

    bumpVersion() {
        let parts = this.version.split(".");
        let major = parts[0].parseInt().unwrapOr(2);
        let minor = parts[1].parseInt().unwrapOr(0) + 1;
        this.version = major.toString() + "." + minor.toString();
        this.grammar.set("version", this.version);
        let mutations = this.grammar.getMut("mutations").asArray();
        for m in this.mutations {
            mutations.push(m);
        }
    },
}
